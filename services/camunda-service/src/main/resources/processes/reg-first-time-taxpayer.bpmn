<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_reg_first_time_taxpayer"
                  targetNamespace="http://camunda.org/examples"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:process id="reg-first-time-taxpayer" name="First-time Registration (Taxpayer Initiated)" isExecutable="true">

    <bpmn:startEvent id="StartEvent" name="Application submitted">
      <bpmn:outgoing>Flow_to_create_document</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="CreateDocument" name="Create registration document" camunda:delegateExpression="${regCreateDocumentDelegate}">
      <bpmn:incoming>Flow_to_create_document</bpmn:incoming>
      <bpmn:outgoing>Flow_to_validate_identity</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ValidateIdentity" name="Validate identity with NIRA or URSB" camunda:delegateExpression="${regValidateIdentityDelegate}">
      <bpmn:incoming>Flow_to_validate_identity</bpmn:incoming>
      <bpmn:outgoing>Flow_to_identity_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="IdentityGateway" name="Identity matched?">
      <bpmn:incoming>Flow_to_identity_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_identity_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_identity_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="PrepareTaxTypes" name="Prepare tax type list" camunda:delegateExpression="${regPrepareTaxTypesDelegate}">
      <bpmn:incoming>Flow_identity_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_to_validate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ValidateApplication" name="Validate application" camunda:delegateExpression="${regValidateApplicationDelegate}">
      <bpmn:incoming>Flow_to_validate</bpmn:incoming>
      <bpmn:outgoing>Flow_to_valid_gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="ValidGateway" name="Data valid?">
      <bpmn:incoming>Flow_to_valid_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="RegisterTaxType" name="Register tax type" camunda:delegateExpression="${regRegisterTaxTypeDelegate}">
      <bpmn:incoming>Flow_valid</bpmn:incoming>
      <bpmn:outgoing>Flow_to_review</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="taxTypes" camunda:elementVariable="taxType" />
    </bpmn:serviceTask>

    <bpmn:userTask id="ReviewRegistration" name="Registration Officer review" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Approve registration?" type="boolean" defaultValue="true" />
          <camunda:formField id="reviewComment" label="Review comment" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_review</bpmn:incoming>
      <bpmn:outgoing>Flow_to_approval_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="ApprovalGateway" name="Approved?">
      <bpmn:incoming>Flow_to_approval_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="FinalizeRegistration" name="Activate taxpayer and obligations" camunda:delegateExpression="${regFinalizeRegistrationDelegate}">
      <bpmn:incoming>Flow_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_to_completed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="RejectRegistration" name="Mark application rejected" camunda:delegateExpression="${regRejectRegistrationDelegate}">
      <bpmn:incoming>Flow_rejected</bpmn:incoming>
      <bpmn:incoming>Flow_invalid</bpmn:incoming>
      <bpmn:incoming>Flow_identity_fail</bpmn:incoming>
      <bpmn:outgoing>Flow_to_rejected_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndCompleted" name="Registration completed">
      <bpmn:incoming>Flow_to_completed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndRejected" name="Registration rejected">
      <bpmn:incoming>Flow_to_rejected_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_to_create_document" sourceRef="StartEvent" targetRef="CreateDocument" />
    <bpmn:sequenceFlow id="Flow_to_validate_identity" sourceRef="CreateDocument" targetRef="ValidateIdentity" />
    <bpmn:sequenceFlow id="Flow_to_identity_gateway" sourceRef="ValidateIdentity" targetRef="IdentityGateway" />
    <bpmn:sequenceFlow id="Flow_identity_ok" name="Yes" sourceRef="IdentityGateway" targetRef="PrepareTaxTypes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${identityMatched == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_identity_fail" name="No" sourceRef="IdentityGateway" targetRef="RejectRegistration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${identityMatched == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_validate" sourceRef="PrepareTaxTypes" targetRef="ValidateApplication" />
    <bpmn:sequenceFlow id="Flow_to_valid_gateway" sourceRef="ValidateApplication" targetRef="ValidGateway" />
    <bpmn:sequenceFlow id="Flow_valid" name="Yes" sourceRef="ValidGateway" targetRef="RegisterTaxType">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${valid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_invalid" name="No" sourceRef="ValidGateway" targetRef="RejectRegistration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${valid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_review" sourceRef="RegisterTaxType" targetRef="ReviewRegistration" />
    <bpmn:sequenceFlow id="Flow_to_approval_gateway" sourceRef="ReviewRegistration" targetRef="ApprovalGateway" />
    <bpmn:sequenceFlow id="Flow_approved" name="Approved" sourceRef="ApprovalGateway" targetRef="FinalizeRegistration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_rejected" name="Rejected" sourceRef="ApprovalGateway" targetRef="RejectRegistration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_completed" sourceRef="FinalizeRegistration" targetRef="EndCompleted" />
    <bpmn:sequenceFlow id="Flow_to_rejected_end" sourceRef="RejectRegistration" targetRef="EndRejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="reg-first-time-taxpayer">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="80" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateDocument_di" bpmnElement="CreateDocument">
        <dc:Bounds x="150" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateIdentity_di" bpmnElement="ValidateIdentity">
        <dc:Bounds x="310" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IdentityGateway_di" bpmnElement="IdentityGateway" isMarkerVisible="true">
        <dc:Bounds x="460" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrepareTaxTypes_di" bpmnElement="PrepareTaxTypes">
        <dc:Bounds x="520" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateApplication_di" bpmnElement="ValidateApplication">
        <dc:Bounds x="690" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidGateway_di" bpmnElement="ValidGateway" isMarkerVisible="true">
        <dc:Bounds x="865" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegisterTaxType_di" bpmnElement="RegisterTaxType">
        <dc:Bounds x="970" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewRegistration_di" bpmnElement="ReviewRegistration">
        <dc:Bounds x="1140" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalGateway_di" bpmnElement="ApprovalGateway" isMarkerVisible="true">
        <dc:Bounds x="1315" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinalizeRegistration_di" bpmnElement="FinalizeRegistration">
        <dc:Bounds x="1410" y="80" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RejectRegistration_di" bpmnElement="RejectRegistration">
        <dc:Bounds x="1280" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndCompleted_di" bpmnElement="EndCompleted">
        <dc:Bounds x="1582" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndRejected_di" bpmnElement="EndRejected">
        <dc:Bounds x="1452" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_to_create_document_di" bpmnElement="Flow_to_create_document">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="150" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_validate_identity_di" bpmnElement="Flow_to_validate_identity">
        <di:waypoint x="270" y="120" />
        <di:waypoint x="310" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_identity_gateway_di" bpmnElement="Flow_to_identity_gateway">
        <di:waypoint x="430" y="120" />
        <di:waypoint x="460" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_identity_ok_di" bpmnElement="Flow_identity_ok">
        <di:waypoint x="510" y="120" />
        <di:waypoint x="520" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_identity_fail_di" bpmnElement="Flow_identity_fail">
        <di:waypoint x="485" y="145" />
        <di:waypoint x="485" y="220" />
        <di:waypoint x="1280" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_validate_di" bpmnElement="Flow_to_validate">
        <di:waypoint x="640" y="120" />
        <di:waypoint x="690" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_valid_gateway_di" bpmnElement="Flow_to_valid_gateway">
        <di:waypoint x="810" y="120" />
        <di:waypoint x="865" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_valid_di" bpmnElement="Flow_valid">
        <di:waypoint x="915" y="120" />
        <di:waypoint x="970" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_invalid_di" bpmnElement="Flow_invalid">
        <di:waypoint x="890" y="145" />
        <di:waypoint x="890" y="260" />
        <di:waypoint x="1280" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_review_di" bpmnElement="Flow_to_review">
        <di:waypoint x="1090" y="120" />
        <di:waypoint x="1140" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_approval_gateway_di" bpmnElement="Flow_to_approval_gateway">
        <di:waypoint x="1260" y="120" />
        <di:waypoint x="1315" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_approved_di" bpmnElement="Flow_approved">
        <di:waypoint x="1365" y="120" />
        <di:waypoint x="1410" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_rejected_di" bpmnElement="Flow_rejected">
        <di:waypoint x="1340" y="145" />
        <di:waypoint x="1340" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_completed_di" bpmnElement="Flow_to_completed">
        <di:waypoint x="1530" y="120" />
        <di:waypoint x="1582" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_rejected_end_di" bpmnElement="Flow_to_rejected_end">
        <di:waypoint x="1400" y="240" />
        <di:waypoint x="1452" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
